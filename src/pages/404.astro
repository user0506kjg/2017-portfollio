---
import MainLayout from '../layouts/MainLayout.astro';
import CyberButton from '../components/CyberButton.astro';
import Reveal from '../components/Reveal.astro';
import SectionAmbience from '../components/SectionAmbience.astro';
import { profile } from '../data/profile';
---

<MainLayout title={`Page Not Found | ${profile.name}`}>
  <section class="min-h-[80vh] flex items-center relative overflow-hidden pt-24">
    <SectionAmbience />
    <div class="max-w-2xl mx-auto px-6 relative text-center">
      <Reveal>
        <p
          class="font-future text-7xl md:text-9xl font-bold text-cyber-blue text-shadow-glow mb-6"
        >
          404
        </p>
      </Reveal>
      <Reveal delay={100}>
        <h1 class="text-2xl md:text-3xl font-bold mb-5 font-future">Signal lost</h1>
      </Reveal>
      <Reveal delay={200}>
        <p class="text-gray-300 mb-10 leading-relaxed">
          That page doesn't exist. Let's get you back to something useful.
        </p>
      </Reveal>
      <Reveal delay={300}>
        <div class="flex flex-wrap gap-4 justify-center">
          <CyberButton href="/">Back Home</CyberButton>
          <CyberButton href="/projects" variant="outline">View Work</CyberButton>
        </div>
      </Reveal>
    </div>
  </section>
</MainLayout>
