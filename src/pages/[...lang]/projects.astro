---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SectionAmbience from '../../components/SectionAmbience.astro';
import Reveal from '../../components/Reveal.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CyberButton from '../../components/CyberButton.astro';
import {
  getContent,
  getFilters,
  getProjects,
  localePath,
  localeStaticPaths,
  type Locale,
} from '../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Locale };
const t = getContent(lang);
const projects = getProjects(lang);
const filters = getFilters(lang);

/**
 * Filters with no matching project yet. Rather than let those tabs render an
 * empty grid as though something broke, each gets an explicit empty state.
 * Computed at build time, so it empties itself as soon as a project carries
 * the matching tag.
 */
const usedTags = new Set(projects.map((p) => p.tag));
const emptyFilters = filters.filter((f) => f.key !== 'all' && !usedTags.has(f.key));
---

<MainLayout
  lang={lang}
  path="/projects"
  title={`${t.meta.projectsTitle} | ${t.profile.name}`}
  description={t.meta.projectsDescription}
>
  <section id="projects" class="pt-32 lg:pt-40 pb-24 relative overflow-hidden">
    <SectionAmbience fade="bottom" />

    <div class="max-w-7xl mx-auto px-6 relative">
      <SectionHeading
        lead={t.ui.projectsLead}
        accent={t.ui.projectsAccent}
        level="h1"
        subtitle={t.ui.projectsSubtitle}
      />

      <div x-data="{ activeTab: 'all' }">
        <!-- Filter tabs -->
        <Reveal class="flex flex-wrap justify-center gap-4 mb-12">
          {
            filters.map((f) => (
              <button
                type="button"
                x-on:click={`activeTab = '${f.key}'`}
                x-bind:class={`activeTab === '${f.key}'
                  ? 'bg-cyber-blue text-cyber-dark'
                  : 'bg-transparent border border-cyber-blue text-cyber-blue hover:bg-cyber-blue/10'`}
                class="cyber-btn font-future font-bold py-2 px-6 transition-all duration-300"
              >
                {f.label}
              </button>
            ))
          }
        </Reveal>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            projects.map((project, i) => (
              <ProjectCard
                project={project}
                lang={lang}
                delay={(((i % 3) + 1) * 100) as 100 | 200 | 300}
                filterable
              />
            ))
          }
        </div>

        {/* Shown only for categories that have no project yet. */}
        {
          emptyFilters.map((f) => (
            <div
              x-show={`activeTab === '${f.key}'`}
              x-transition.opacity.duration.300ms
              class="text-center py-20"
              style="display: none;"
            >
              <div class="w-14 h-14 mx-auto rounded-full bg-cyber-blue/10 border border-cyber-blue/30 flex items-center justify-center mb-5">
                <i class="fas fa-folder-open text-cyber-blue text-xl" aria-hidden="true" />
              </div>
              <p class="text-cyber-blue font-future text-lg mb-2">{t.ui.nothingHereTitle}</p>
              <p class="text-gray-400 text-sm max-w-md mx-auto leading-relaxed">
                {t.ui.nothingHereBody}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section id="cta" class="bg-cyber-dark/50 py-24 relative overflow-hidden">
    <SectionAmbience />
    <div class="max-w-4xl mx-auto px-6 relative text-center">
      <Reveal>
        <h2 class="text-3xl lg:text-4xl font-bold mb-6 font-future">
          {t.ui.projectsCtaLead}
          <span class="text-cyber-blue text-shadow-glow">{t.ui.projectsCtaAccent}</span>
        </h2>
      </Reveal>
      <Reveal delay={100}>
        <p class="text-gray-300 mb-10 max-w-xl mx-auto leading-relaxed">{t.ui.projectsCtaBody}</p>
      </Reveal>
      <Reveal delay={200}>
        <CyberButton href={localePath(lang, '/about')}>{t.ui.myBackground}</CyberButton>
      </Reveal>
    </div>
  </section>
</MainLayout>
