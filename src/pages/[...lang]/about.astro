---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SectionAmbience from '../../components/SectionAmbience.astro';
import Reveal from '../../components/Reveal.astro';
import Counters from '../../components/Counters.astro';
import CyberButton from '../../components/CyberButton.astro';
import { getContent, localePath, localeStaticPaths, type Locale } from '../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Locale };
const t = getContent(lang);
---

<MainLayout
  lang={lang}
  path="/about"
  title={`${t.meta.aboutTitle} | ${t.profile.name}`}
  description={t.meta.aboutDescription}
>
  <!-- ================= PAGE HERO ================= -->
  <section
    id="about-hero"
    class="pt-32 lg:pt-40 pb-16 lg:pb-24 bg-cyber-dark/60 relative overflow-hidden"
  >
    <SectionAmbience fade="bottom" />

    <div class="max-w-7xl mx-auto px-6 relative">
      <div class="max-w-3xl">
        <Reveal>
          <p class="text-cyber-blue font-future text-sm tracking-[0.25em] uppercase mb-4">
            {t.ui.aboutEyebrow}
          </p>
        </Reveal>
        <Reveal delay={100}>
          <h1 class="text-4xl lg:text-6xl font-bold mb-6 font-future leading-[1.1] tracking-tight">
            {t.profile.given}{' '}
            <span class="text-cyber-blue text-shadow-glow">{t.profile.family}</span>
          </h1>
        </Reveal>
        <Reveal delay={200}>
          <p class="text-cyber-blue/80 font-future mb-6">{t.profile.roleFull}</p>
        </Reveal>
        <Reveal delay={300}>
          <p class="text-gray-300 text-lg leading-relaxed">{t.profile.summary}</p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ================= PROFILE ================= -->
  <section id="profile" class="py-24 relative overflow-hidden">
    <SectionAmbience fade="top" orbs={false} />

    <div class="max-w-7xl mx-auto px-6 relative">
      <SectionHeading lead={t.ui.aboutApproachLead} accent={t.ui.aboutApproachAccent} />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
        <Reveal direction="left">
          <div class="group relative h-full">
            <div class="card-halo rounded-xl" aria-hidden="true"></div>
            <div class="card p-8">
              <div
                class="w-12 h-12 rounded-full bg-cyber-blue/20 border border-cyber-blue flex items-center justify-center mb-5 glow"
              >
                <i class="fas fa-compass-drafting text-cyber-blue text-xl" aria-hidden="true"></i>
              </div>
              <h3 class="text-xl font-bold mb-4 text-cyber-blue font-future">
                {t.ui.aboutPragmatic}
              </h3>
              <p class="text-gray-300 leading-relaxed">{t.profile.summaryCont}</p>
            </div>
          </div>
        </Reveal>

        <Reveal direction="right" delay={200}>
          <div class="group relative h-full">
            <div class="card-halo rounded-xl" aria-hidden="true"></div>
            <div class="card p-8">
              <div
                class="w-12 h-12 rounded-full bg-cyber-blue/20 border border-cyber-blue flex items-center justify-center mb-5 glow"
              >
                <i class="fas fa-layer-group text-cyber-blue text-xl" aria-hidden="true"></i>
              </div>
              <h3 class="text-xl font-bold mb-4 text-cyber-blue font-future">
                {t.ui.aboutSpecialise}
              </h3>
              <ul class="space-y-3 text-gray-300">
                {
                  t.ui.aboutSpecialiseItems.map((item) => (
                    <li class="flex items-start gap-3">
                      <i
                        class="fas fa-check text-cyber-blue mt-1 text-sm shrink-0"
                        aria-hidden="true"
                      />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </Reveal>
      </div>

      <Counters lang={lang} />
    </div>
  </section>

  <!-- ================= EXPERIENCE ================= -->
  <section id="experience" class="bg-cyber-dark/60 py-24 relative overflow-hidden">
    <SectionAmbience fade="both" />

    <div class="max-w-7xl mx-auto px-6 relative">
      <SectionHeading
        lead={t.ui.aboutExperienceLead}
        accent={t.ui.aboutExperienceAccent}
        subtitle={t.ui.aboutExperienceSubtitle}
      />

      <div class="relative max-w-6xl mx-auto">
        <!-- timeline spine -->
        <div
          class="absolute left-4 top-2 bottom-2 w-px bg-gradient-to-b from-transparent via-cyber-blue/40 to-transparent"
          aria-hidden="true"
        >
        </div>

        <div class="space-y-10">
          {
            t.experience.map((role) => (
              <Reveal direction="up" class="relative ps-12 md:ps-16">
                <div
                  class="absolute left-4 top-8 -translate-x-1/2 w-4 h-4 rounded-full bg-cyber-dark border-2 border-cyber-blue glow z-10"
                  aria-hidden="true"
                >
                  {role.current && (
                    <span class="absolute inset-0 rounded-full bg-cyber-blue animate-ping opacity-75" />
                  )}
                </div>

                <div class="group relative">
                  <div class="card-halo rounded-xl" aria-hidden="true" />
                  {/* Fixed min-height keeps all three cards the same shape. */}
                  <div class="card p-6 md:p-8 flex flex-col lg:min-h-[30rem] xl:min-h-[27rem]">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 pb-5 mb-6 border-b border-cyber-blue/15">
                      <div>
                        <h3 class="text-xl md:text-2xl font-bold text-cyber-blue font-future leading-snug">
                          {role.title}
                        </h3>
                        <p class="text-white font-semibold mt-1">{role.company}</p>
                      </div>

                      <div class="flex flex-col sm:items-end gap-2 shrink-0">
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="text-xs font-future text-cyber-blue border border-cyber-blue/30 bg-cyber-blue/5 rounded-full px-3 py-1 whitespace-nowrap">
                            {role.period}
                          </span>
                          {role.current && (
                            <span class="text-xs font-future text-cyber-dark bg-cyber-blue rounded-full px-3 py-1 font-bold">
                              {t.ui.current}
                            </span>
                          )}
                        </div>
                        <p class="text-gray-500 text-sm flex items-center gap-2 whitespace-nowrap">
                          <i class="fas fa-location-dot text-cyber-blue/50" aria-hidden="true" />
                          {role.location}
                        </p>
                      </div>
                    </div>

                    <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-3 content-start grow">
                      {role.bullets.map((b) => (
                        <li class="flex items-start gap-3 text-gray-300 text-sm leading-relaxed">
                          <i
                            class="fas fa-angle-right text-cyber-blue mt-1 text-xs shrink-0"
                            aria-hidden="true"
                          />
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </Reveal>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ================= EDUCATION ================= -->
  <section id="education" class="py-24 relative overflow-hidden">
    <SectionAmbience fade="top" orbs={false} />

    <div class="max-w-7xl mx-auto px-6 relative">
      <SectionHeading lead="" accent={t.ui.aboutEducationAccent} />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {
          t.education.map((item, i) => (
            <Reveal delay={((i + 1) * 100) as 100 | 200} class="group relative">
              <div class="card-halo rounded-xl" aria-hidden="true" />
              <div class="card p-8 text-center">
                <div class="w-14 h-14 mx-auto rounded-full bg-cyber-blue/20 border border-cyber-blue flex items-center justify-center mb-5 glow">
                  <i class={`${item.icon} text-cyber-blue text-xl`} aria-hidden="true" />
                </div>
                <h3 class="text-lg font-bold text-cyber-blue font-future leading-snug mb-2">
                  {item.degree}
                </h3>
                <p class="text-white">{item.school}</p>
                <p class="text-gray-500 text-sm mt-2 font-future">{item.period}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section id="cta" class="bg-cyber-dark/50 py-24 relative overflow-hidden">
    <SectionAmbience />
    <div class="max-w-4xl mx-auto px-6 relative text-center">
      <Reveal>
        <h2 class="text-3xl lg:text-4xl font-bold mb-6 font-future">
          {t.ui.aboutCtaLead}{' '}
          <span class="text-cyber-blue text-shadow-glow">{t.ui.aboutCtaAccent}</span>
        </h2>
      </Reveal>
      <Reveal delay={100}>
        <p class="text-gray-300 mb-10 max-w-xl mx-auto leading-relaxed">{t.ui.aboutCtaBody}</p>
      </Reveal>
      <Reveal delay={200}>
        <div class="flex flex-wrap gap-4 justify-center">
          <CyberButton href={localePath(lang, '/projects')}>{t.ui.seeMyWork}</CyberButton>
          <CyberButton href={localePath(lang, '/expertise')} variant="outline">
            {t.ui.myExpertise}
          </CyberButton>
        </div>
      </Reveal>
    </div>
  </section>
</MainLayout>
