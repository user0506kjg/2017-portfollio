---
import { getContent, localePath, type Locale } from '../i18n';
import SectionAmbience from './SectionAmbience.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getContent(lang);
const year = 2017;

const items = [
  { key: '/', label: t.nav.home },
  { key: '/about', label: t.nav.about },
  { key: '/expertise', label: t.nav.expertise },
  { key: '/projects', label: t.nav.projects },
];
const half = Math.ceil(items.length / 2);
const colA = items.slice(0, half);
const colB = items.slice(half);
---

<footer class="relative z-10 bg-cyber-dark py-16 border-t border-cyber-blue/20 overflow-hidden">
  <SectionAmbience />

  <div class="max-w-7xl mx-auto px-6 relative">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Brand -->
      <div>
        <div class="flex items-center mb-6 font-future">
          <div
            class="w-10 h-10 rounded-full bg-cyber-blue/20 border border-cyber-blue flex items-center justify-center glow"
          >
            <span class="text-cyber-blue text-xl font-bold">{t.profile.initial}</span>
          </div>
          <span class="ml-3 text-xl font-bold">
            <span class="text-white">{t.profile.given}</span>
            <span class="text-cyber-blue"> {t.profile.family}</span>
          </span>
        </div>
        <p class="text-gray-300 leading-relaxed">{t.profile.heroBlurb}</p>
      </div>

      <!-- Navigation -->
      <div class="grid grid-cols-2 gap-4 lg:ps-12">
        <div>
          <h3 class="text-lg font-bold text-cyber-blue mb-6 font-future">{t.ui.footerExplore}</h3>
          <ul class="space-y-3">
            {
              colA.map((item) => (
                <li>
                  <a
                    href={localePath(lang, item.key)}
                    class="text-gray-300 hover:text-cyber-blue transition-colors duration-200"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-bold text-cyber-blue mb-6 font-future">{t.ui.footerMore}</h3>
          <ul class="space-y-3">
            {
              colB.map((item) => (
                <li>
                  <a
                    href={localePath(lang, item.key)}
                    class="text-gray-300 hover:text-cyber-blue transition-colors duration-200"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-cyber-blue/10 flex justify-center items-center">
      <p class="text-gray-400 text-sm">
        &copy; {year} {t.profile.name}. {t.ui.rightsReserved}
      </p>
    </div>
  </div>
</footer>
