---
import { profile } from '../data/profile';
import SolarSystem from './SolarSystem.astro';
import CyberButton from './CyberButton.astro';
import Reveal from './Reveal.astro';
---

<section id="home" class="min-h-screen flex items-center pt-24 pb-16 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 py-12 lg:py-24 relative w-full">
    <!-- ambient orbs -->
    <div
      class="absolute w-96 h-96 bg-cyber-blue/10 rounded-full blur-3xl -top-20 -left-20 animate-pulse-slow pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute w-64 h-64 bg-cyber-blue/10 rounded-full blur-3xl bottom-10 right-10 animate-pulse-slow pointer-events-none"
      style="animation-delay: 3s;"
      aria-hidden="true"
    >
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center relative">
      <!-- Copy -->
      <div class="order-2 lg:order-1">
        <Reveal direction="up" class="inline-block mb-5">
          <span
            class="inline-flex items-center gap-2 text-xs font-future tracking-widest uppercase text-cyber-blue border border-cyber-blue/30 bg-cyber-blue/5 rounded-full px-4 py-2"
          >
            <span class="relative flex size-2">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyber-blue opacity-75"
              ></span>
              <span class="relative inline-flex size-2 rounded-full bg-cyber-blue"></span>
            </span>
            Available for Senior AI Engineering Work
          </span>
        </Reveal>

        <Reveal direction="up" delay={100}>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4 font-future leading-[1.1] tracking-tight">
            <span class="text-cyber-blue text-shadow-glow">{profile.heroLead}</span>
            {' '}{profile.heroRest}
          </h1>
        </Reveal>

        <Reveal direction="up" delay={200}>
          <p class="text-cyber-blue/80 font-future text-sm md:text-base mb-5 tracking-wide">
            {profile.roleFull}
          </p>
        </Reveal>

        <Reveal direction="up" delay={300}>
          <p class="text-gray-300 text-lg mb-8 max-w-xl leading-relaxed">{profile.heroBlurb}</p>
        </Reveal>

        <Reveal direction="up" delay={400}>
          <div class="flex flex-wrap gap-4">
            <CyberButton href="#projects" smooth>View Work</CyberButton>
            <CyberButton href="/about" variant="outline">My Background</CyberButton>
          </div>
        </Reveal>

      </div>

      <!-- Orbiting stack around the AI chip -->
      <div class="order-1 lg:order-2 flex justify-center relative">
        <SolarSystem />
      </div>
    </div>
  </div>
</section>

