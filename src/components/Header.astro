---
import { nav, profile } from '../data/profile';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  x-data="{ mobileMenuOpen: false, scrolled: false }"
  x-on:scroll.window="scrolled = window.scrollY > 20"
  x-bind:class="scrolled ? 'bg-cyber-dark/90 shadow-lg shadow-cyber-blue/5' : 'bg-cyber-dark/70'"
  class="fixed w-full z-40 backdrop-blur-md border-b border-cyber-blue/20 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-6 py-4">
    <div class="flex justify-between items-center">
      <!-- Monogram + wordmark -->
      <a href="/" class="flex items-center font-future group" aria-label={`${profile.name} — home`}>
        <div
          class="w-10 h-10 rounded-full bg-cyber-blue/20 border border-cyber-blue flex items-center justify-center glow transition-transform duration-300 group-hover:scale-110"
        >
          <span class="text-cyber-blue text-xl font-bold">{profile.initial}</span>
        </div>
        <span class="ml-3 text-xl font-bold">
          <span class="text-white">Jean-Luc</span>
          <span class="text-cyber-blue"> Pinas</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex space-x-8 font-future text-sm" aria-label="Main navigation">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative transition-colors duration-300 hover:text-cyber-blue',
                isActive(item.href) ? 'text-cyber-blue' : 'text-white',
              ]}
            >
              {item.label}
              {isActive(item.href) && (
                <span class="absolute -bottom-1.5 left-0 w-full h-px bg-cyber-blue glow-sm" />
              )}
            </a>
          ))
        }
      </nav>

      <!-- Mobile toggle -->
      <button
        x-on:click="mobileMenuOpen = !mobileMenuOpen"
        x-bind:aria-expanded="mobileMenuOpen.toString()"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
        class="lg:hidden text-cyber-blue w-10 h-10 flex items-center justify-center rounded-md border border-cyber-blue/30 hover:bg-cyber-blue/10 transition-colors"
      >
        <i class="fas fa-bars text-lg" x-show="!mobileMenuOpen"></i>
        <i class="fas fa-xmark text-lg" x-show="mobileMenuOpen" style="display: none;"></i>
      </button>
    </div>

    <!-- Mobile nav -->
    <div
      id="mobile-menu"
      x-show="mobileMenuOpen"
      x-transition.opacity.duration.200ms
      x-on:click.outside="mobileMenuOpen = false"
      class="lg:hidden mt-4 pb-2"
      style="display: none;"
    >
      <nav class="flex flex-col space-y-1 font-future" aria-label="Mobile navigation">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'py-3 px-4 rounded-md transition-colors duration-200 hover:bg-cyber-blue/10 hover:text-cyber-blue',
                isActive(item.href)
                  ? 'text-cyber-blue bg-cyber-blue/10 border-l-2 border-cyber-blue'
                  : 'text-white',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
